{
  "name": "slim-launcher-website",
  "version": "1.0.0",
  "description": "Slim launcher website",
  "author": "Beautus",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt generate",
    "preview": "serve .output/public --listen tcp://127.0.0.1:4173",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "nuxt": "4.5.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
